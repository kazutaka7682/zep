# Zep Configuration
ZEP_API_SECRET=your_zep_api_secret_here

# Azure OpenAI Configuration
AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-12-01-preview

# Azure Model Deployments
AZURE_LLM_DEPLOYMENT_NAME=your_llm_deployment_name
AZURE_EMBEDDING_DEPLOYMENT_NAME=your_embedding_deployment_name

# LiteLLM Proxy Configuration
LITELLM_MASTER_KEY=your_litellm_master_key

# Dummy OpenAI API Key (required but not used when using LiteLLM proxy)
OPENAI_API_KEY=dummy-key-for-litellm-proxy